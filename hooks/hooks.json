{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/tools/check_toolchain.sh"],
            "statusMessage": "Probing C++ toolchain"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/tools/cpp26_lint/quick_lint.py",
              "--compact"
            ],
            "if": "Edit(*.cpp)|Edit(*.cc)|Edit(*.cxx)|Edit(*.c++)|Edit(*.h)|Edit(*.hpp)|Edit(*.hxx)|Edit(*.h++)|Edit(*.ipp)|Edit(*.tpp)|Write(*.cpp)|Write(*.cc)|Write(*.cxx)|Write(*.c++)|Write(*.h)|Write(*.hpp)|Write(*.hxx)|Write(*.h++)|Write(*.ipp)|Write(*.tpp)",
            "statusMessage": "C++26 anti-pattern check"
          }
        ]
      }
    ]
  }
}
